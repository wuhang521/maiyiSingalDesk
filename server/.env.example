TASK_DATABASE_URL=mysql+pymysql://signaldesk:replace-password@127.0.0.1:3306/signaldesk_tasks?charset=utf8mb4
TASK_API_KEY=replace-with-a-long-random-token
TASK_CORS_ORIGINS=*
ARK_API_KEY=replace-with-an-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL_ID=doubao-seedance-2-0-mini-260615
TTS_APP_ID=replace-with-a-tts-app-id
TTS_ACCESS_TOKEN=replace-with-a-tts-access-token
TTS_VOICE_TYPE=zh_female_cancan_mars_bigtts
TASK_HERMES_WEBHOOK_URL=http://127.0.0.1:8081/task-reminder
TASK_HERMES_WEBHOOK_SECRET=replace-with-another-random-token
TASK_REMINDER_POLL_SECONDS=60

# Private knowledge library; keep outside any public/static web directory.
TASK_KNOWLEDGE_STORAGE_DIR=./knowledge-files
TASK_KNOWLEDGE_MAX_UPLOAD_MB=500
TASK_KNOWLEDGE_SEMANTIC_MAX_CHUNKS=2000
# All CNY values are decimal strings, max 6 fraction digits. No invented provider prices.
# Supply conservative per-submission ceilings covering all calls / frames / pages.
TASK_KNOWLEDGE_MONEY_BUDGET_ENABLED=false
TASK_KNOWLEDGE_BUDGET_DAILY_CNY=0
TASK_KNOWLEDGE_BUDGET_MONTHLY_CNY=0
TASK_KNOWLEDGE_REQUEST_CEILING_CNY={}
# Optional local native WeChat voice decoding. Install and pin pilk during acceptance first.
TASK_KNOWLEDGE_SILK_ENABLED=false
TASK_KNOWLEDGE_USER_QUOTA_MB=5120
TASK_KNOWLEDGE_QUEUE_LIMIT=200
# Disabled until a tested local ASR adapter and model are explicitly installed.
TASK_KNOWLEDGE_ASR_ENABLED=false
TASK_KNOWLEDGE_ASR_COMMAND=
# Cloud speech recognition is a separate explicit operation; never reuse OCR/TTS keys.
TASK_KNOWLEDGE_CLOUD_ASR_ENABLED=false
TASK_KNOWLEDGE_CLOUD_ASR_API_KEY=
# Legacy console alternative; use ONLY credentials explicitly enabled for ASR.
TASK_KNOWLEDGE_CLOUD_ASR_APP_ID=
TASK_KNOWLEDGE_CLOUD_ASR_ACCESS_KEY=
TASK_KNOWLEDGE_CLOUD_ASR_MAX_MINUTES=10
# Conservative submission admission, UTC day/month; not actual monetary billing.
# 0 disables new paid recognition requests. Purging content never resets this ledger.
TASK_KNOWLEDGE_PAID_DAILY_LIMIT=20
TASK_KNOWLEDGE_PAID_MONTHLY_LIMIT=200
TASK_KNOWLEDGE_FFMPEG_BINARY=ffmpeg
TASK_KNOWLEDGE_FFPROBE_BINARY=ffprobe
# Sparse video-frame OCR; a task can incur up to this many OCR requests.
# Uses the dedicated OCR key, never ASR/TTS credentials. Disabled pending joint acceptance.
TASK_KNOWLEDGE_VIDEO_OCR_ENABLED=false
TASK_KNOWLEDGE_VIDEO_OCR_MAX_FRAMES=6
# Dedicated random secret shared only between Hermes plugin and backend, not desktop.
TASK_KNOWLEDGE_GATEWAY_SECRET=
# 0 preserves trash indefinitely. Enabling >0 irreversibly expires all users' trash.
# Back up DB/files and agree retention policy before enabling (e.g. 30).
TASK_KNOWLEDGE_TRASH_RETENTION_DAYS=0
# Opt-in Q&A only; reuses TASK_PROMPT_* below. No OCR / ASR is implied.
# Only enable after checking provider access, costs and private-data policy.
TASK_KNOWLEDGE_CLOUD_QA_ENABLED=false
# Separate opt-in AI summary/points/tag suggestions over one current full body.
TASK_KNOWLEDGE_ORGANIZATION_ENABLED=false
# Explicit per-document cloud indexing; no automatic whole-library transmission.
# Requires permission for the TEXT embeddings API, not a chat / vision model.
# Use a pinned, versioned text embedding model ID. No guessed default model.
TASK_KNOWLEDGE_SEMANTIC_ENABLED=false
TASK_KNOWLEDGE_EMBEDDING_API_KEY=
TASK_KNOWLEDGE_EMBEDDING_MODEL=
# Qwen selection for 0.6.1. Only dedicated server settings; never ship real keys.
# Set CLOUD_ASR_PROVIDER=qwen, EMBEDDING_PROVIDER=qwen and
# EMBEDDING_MODEL=text-embedding-v4 before enabling those features above.
TASK_KNOWLEDGE_CLOUD_ASR_PROVIDER=volc
TASK_KNOWLEDGE_CLOUD_ASR_MODEL=qwen3-asr-flash
TASK_KNOWLEDGE_EMBEDDING_PROVIDER=ark
TASK_KNOWLEDGE_QWEN_API_KEY=
TASK_KNOWLEDGE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Separate notification/monitor worker; enable only after validating dedicated
# deliver_only Hermes routes and opt-in owner channel preferences.
TASK_KNOWLEDGE_DISPATCH_ENABLED=false
TASK_KNOWLEDGE_NOTIFICATION_WEBHOOK_BASE=
TASK_KNOWLEDGE_NOTIFICATION_WEBHOOK_SECRET=
# Image / PDF OCR: server-only, opt-in for each original; no automatic paid retries.
# Fixed Ark endpoint; never put this key in renderer, chat, or installer.
TASK_KNOWLEDGE_OCR_ENABLED=false
TASK_KNOWLEDGE_OCR_API_KEY=
TASK_KNOWLEDGE_OCR_MODEL=doubao-seed-2-0-lite-260428
TASK_KNOWLEDGE_OCR_MAX_PDF_PAGES=10
TASK_REMINDER_START_HOUR=9
TASK_REMINDER_END_HOUR=20

# 内容创作 / 提示词文本模型；真实 Key 由项目负责人单独交接。
TASK_PROMPT_API_KEY=
TASK_PROMPT_BASE_URL=https://api.deepseek.com
TASK_PROMPT_MODEL=deepseek-flash
