[Unit]
Description=SignalDesk personal knowledge extraction worker
After=network.target

[Service]
User=signaldesk-task
Group=signaldesk-task
WorkingDirectory=/opt/signaldesk-task
EnvironmentFile=/opt/signaldesk-task/.env
ExecStart=/opt/signaldesk-task/.venv/bin/python -m app.knowledge_worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
