[Unit]
Description=SignalDesk shared task API
After=network-online.target mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=signaldesk-task
Group=signaldesk-task
WorkingDirectory=/opt/signaldesk-task
EnvironmentFile=/opt/signaldesk-task/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/signaldesk-task/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 19080
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWriteDirectories=/opt/signaldesk-task

[Install]
WantedBy=multi-user.target
