[Unit]
Description=SignalDesk personal knowledge notifications and queue monitor
After=network.target signaldesk-task-api.service

[Service]
User=signaldesk-task
Group=signaldesk-task
WorkingDirectory=/opt/signaldesk-task
EnvironmentFile=/opt/signaldesk-task/.env
ExecStart=/opt/signaldesk-task/.venv/bin/python -m app.knowledge_dispatch
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
