[Unit]
Description=SignalDesk shared task reminder worker
After=network-online.target mysqld.service docker.service signaldesk-task-api.service
Wants=network-online.target

[Service]
Type=simple
User=signaldesk-task
Group=signaldesk-task
WorkingDirectory=/opt/signaldesk-task
EnvironmentFile=/opt/signaldesk-task/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/signaldesk-task/.venv/bin/python -m app.worker
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWriteDirectories=/opt/signaldesk-task

[Install]
WantedBy=multi-user.target
